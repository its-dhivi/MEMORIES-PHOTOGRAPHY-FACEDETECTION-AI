NODE_ENV=development
SWAGGER_ENABLED=true
POSTGRES_DB=memories_photo_finder
POSTGRES_USER=memories
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://memories:change-me-local-only@postgres:5432/memories_photo_finder?schema=public
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=memories-local
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_ORIGINALS=photo-originals
S3_BUCKET_DERIVATIVES=photo-derivatives
MAX_PHOTO_BYTES=524288000
MAX_ORIGINAL_PHOTO_BYTES=524288000
MULTIPART_UPLOAD_THRESHOLD_BYTES=33554432
MULTIPART_PART_SIZE_BYTES=16777216
MULTIPART_MAX_PARTS_PER_REQUEST=100
STUDIO_STORAGE_QUOTA_BYTES=536870912000
PRESIGNED_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=3600
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
COOKIE_SECRET=replace-with-another-32-character-secret
PASSWORD_RESET_PEPPER=replace-with-a-32-character-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://face-ai:8000
AI_INTERNAL_TOKEN=replace-with-an-internal-service-token
FACE_MODEL_PROVIDER=onnx
FACE_MODEL_NAME=arcface-resnet100-int8
FACE_MODEL_VERSION=arcface-resnet100-int8-v1
FACE_RECOGNITION_MODEL_PATH=/models/arcfaceresnet100-11-int8.onnx
FACE_DETECTION_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_OUTPUT_DIMENSION=512
FACE_EMBEDDING_DIMENSION=512
FACE_DEVICE=cpu
FACE_DETECTION_INPUT_SIZE=640
FACE_DETECTION_THRESHOLD=0.75
FACE_MIN_SIZE_PIXELS=48
FACE_MIN_BLUR_VARIANCE=35
FACE_MIN_EXPOSURE=35
FACE_MAX_EXPOSURE=225
FACE_MAX_CONCURRENT_INFERENCES=2
FACE_INFERENCE_TIMEOUT_SECONDS=60
FACE_PROCESSING_MAX_RETRIES=5
FACE_MATCH_MAX_RESULTS=100
GUEST_ZIP_MAX_PHOTOS=250
GUEST_ZIP_MAX_BYTES=10737418240
GUEST_ZIP_MAX_OUTPUT_BYTES=11811160064
GUEST_ZIP_JOB_TIMEOUT_SECONDS=3600
MAX_IMAGE_BYTES=524288000
MAX_IMAGE_PIXELS=80000000
LOG_LEVEL=info
