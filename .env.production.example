# Copy to .env.production outside version control. Use unique randomly generated values.
NODE_ENV=production
SWAGGER_ENABLED=false
DOMAIN=photos.example.in
S3_PUBLIC_DOMAIN=s3.photos.example.in
POSTGRES_DB=memories_photo_finder
POSTGRES_USER=memories
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://memories:URL_ENCODED_PASSWORD@postgres:5432/memories_photo_finder?schema=public
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.photos.example.in
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_STORAGE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_RANDOM_STORAGE_SECRET
S3_BUCKET_ORIGINALS=photo-originals
S3_BUCKET_DERIVATIVES=photo-derivatives
STUDIO_STORAGE_QUOTA_BYTES=536870912000
WEB_ORIGIN=https://photos.example.in
NEXT_PUBLIC_API_URL=https://photos.example.in/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
PUBLIC_APP_URL=https://photos.example.in
AI_SERVICE_URL=http://face-ai:8000
AI_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_TOKEN
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
COOKIE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
PASSWORD_RESET_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FACE_DEVICE=cpu
FACE_MODEL_PROVIDER=onnx
FACE_MODEL_NAME=auraface-v1
FACE_MODEL_VERSION=auraface-v1-rgb-normalized-v1
FACE_PREPROCESSING_VERSION=auraface-rgb-112-v1
FACE_DETECTION_PIPELINE_VERSION=phase5-v2
FACE_RECOGNITION_MODEL_PATH=/models/auraface.onnx
FACE_RECOGNITION_INPUT_NORMALIZATION=minus_one_one
FACE_DETECTION_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_OUTPUT_DIMENSION=512
FACE_EMBEDDING_DIMENSION=512
FACE_MAX_CONCURRENT_INFERENCES=1
POSTGRES_DATA_DIR=./data/postgres
OBJECTS_DATA_DIR=./data/objects
TLS_CERT_DIR=./secrets/tls
