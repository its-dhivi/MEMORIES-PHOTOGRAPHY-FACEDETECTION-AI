{
  "name": "memories-photo-finder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @memories/web --filter @memories/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @memories/api prisma:generate",
    "db:migrate": "pnpm --filter @memories/api prisma:migrate",
    "db:seed": "pnpm --filter @memories/api prisma:seed",
    "env:check": "node scripts/verify-env.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.57.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
